# Server
# macOS binds 5000/7000 to AirPlay Receiver by default, so this project uses 5001.
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB (create a free cluster at https://www.mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Uploaded images/CVs go to a private S3 bucket (keys storage/images/... and
# storage/documents/...) and are served through CloudFront at CDN_URL.
# The IAM user needs only s3:PutObject/GetObject/DeleteObject on the bucket.
S3_BUCKET=your-bucket-name
S3_REGION=eu-north-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_URL=https://dxxxxxxxxxxxx.cloudfront.net

# Initial admin account, used only by `npm run seed`
SEED_ADMIN_NAME=Omojola Obaloluwa Favour
SEED_ADMIN_EMAIL=horbahstech@gmail.com
SEED_ADMIN_PASSWORD=change-me-after-first-login

# AI writing assistant (admin panel only) — server-side only, never exposed
# to the frontend. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
